{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "target.json (contracts v0.7)",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "synthetic",
    "center",
    "size_arcmin",
    "image",
    "provenance",
    "frames",
    "known_objects",
    "detections"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "synthetic": {
      "type": "boolean"
    },
    "center": {
      "$ref": "#/$defs/sky"
    },
    "size_arcmin": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "image": {
      "type": "object",
      "required": [
        "width",
        "height",
        "pixel_scale_arcsec"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "pixel_scale_arcsec": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "service",
          "query",
          "retrieved_utc"
        ],
        "properties": {
          "service": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "retrieved_utc": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "time_utc",
          "mjd",
          "epoch",
          "detector",
          "wavelength_um",
          "image",
          "obs_id",
          "source_url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "time_utc": {
            "type": "string",
            "format": "date-time"
          },
          "mjd": {
            "type": "number"
          },
          "epoch": {
            "type": "integer",
            "minimum": 1
          },
          "detector": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 6
          },
          "wavelength_um": {
            "type": "number",
            "minimum": 0.7,
            "maximum": 5.1
          },
          "image": {
            "type": "string",
            "pattern": "^frames/.+\\.(png|webp)$"
          },
          "obs_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "collection": {
            "type": "string",
            "description": "v0.17 (T64): IRSA collection = SPHEREx release, e.g. spherex_dr1, spherex_qr3_deep"
          },
          "bandwidth_um": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "known_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source",
          "synthetic",
          "positions"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "synthetic": {
            "type": "boolean"
          },
          "positions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/framePosition"
            }
          }
        }
      }
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "matched_object",
          "synthetic",
          "score",
          "track"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "known",
              "unknown",
              "artifact"
            ]
          },
          "matched_object": {
            "type": [
              "string",
              "null"
            ]
          },
          "synthetic": {
            "type": "boolean"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "track": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/framePosition"
            }
          },
          "motion": {
            "type": "object",
            "required": [
              "rate_arcsec_per_hr",
              "pa_deg"
            ],
            "properties": {
              "rate_arcsec_per_hr": {
                "type": "number",
                "minimum": 0
              },
              "pa_deg": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              }
            }
          },
          "reason": {
            "type": "string",
            "description": "v0.9: plain-words reason for the status (detect.classify, T08)"
          }
        }
      }
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "a",
          "b",
          "detector",
          "dwave_um",
          "dt_days"
        ],
        "properties": {
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          },
          "detector": {
            "type": [
              "integer",
              "null"
            ]
          },
          "dwave_um": {
            "type": "number",
            "minimum": 0
          },
          "dt_days": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "source_exposures": {
      "type": "object",
      "description": "v0.17 (T64): the SPHEREx exposures covering the centre when the field was built (the frames are a selection)",
      "required": ["count"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "latest_mjd": { "type": ["number", "null"] },
        "latest_utc": { "type": ["string", "null"] },
        "collections": { "type": "array", "items": { "type": "string" } },
        "checked_utc": { "type": ["string", "null"] }
      }
    },
    "labels_requested": {
      "type": "boolean",
      "description": "v0.8: GET /api/targets/<id>/labels has run (labels are filled, possibly empty)"
    },
    "objects_requested": {
      "type": "boolean",
      "description": "v0.11: GET /api/targets/<id>/objects has run (known_objects and detections are filled)"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "otype",
          "source",
          "named",
          "positions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "otype": {
            "type": "string"
          },
          "source": {
            "enum": [
              "simbad",
              "gaia_dr3",
              "synthetic",
              "vsx",
              "catwise2020",
              "horizons"
            ],
            "description": "v0.11: synthetic = made-up object in a synthetic fixture, never on real frames; v0.12 (T52): vsx = variable stars, catwise2020 = red moving WISE sources, horizons = planets and moons"
          },
          "named": {
            "type": "boolean"
          },
          "mag": {
            "type": [
              "number",
              "null"
            ]
          },
          "pm_mas_yr": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "positions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/framePosition"
            }
          },
          "motion": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "shift_arcsec",
              "shift_px",
              "class"
            ],
            "properties": {
              "shift_arcsec": {
                "type": "number",
                "minimum": 0
              },
              "shift_px": {
                "type": "number",
                "minimum": 0
              },
              "days": {
                "type": "number"
              },
              "rate_arcsec_per_yr": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "max_rate_within_epoch_arcsec_per_hr": {
                "type": "number",
                "minimum": 0
              },
              "pa_deg": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "direction": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "class": {
                "enum": [
                  "still",
                  "proper motion",
                  "fast mover",
                  "distant body?"
                ]
              },
              "note": {
                "type": "string"
              },
              "reach_arcsec": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "importance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string",
            "description": "v0.11 (T52): one line about the object, e.g. VSX type, period and range"
          },
          "mag_band": {
            "type": "string",
            "description": "v0.11 (T52): band of `mag` (G = Gaia, V or a VSX passband, W2 = WISE); absent = G"
          }
        }
      }
    }
  },
  "$defs": {
    "sky": {
      "type": "object",
      "required": [
        "ra_deg",
        "dec_deg"
      ],
      "properties": {
        "ra_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "dec_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    },
    "framePosition": {
      "type": "object",
      "required": [
        "frame_id",
        "ra_deg",
        "dec_deg",
        "x",
        "y"
      ],
      "properties": {
        "frame_id": {
          "type": "string"
        },
        "ra_deg": {
          "type": "number"
        },
        "dec_deg": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    }
  }
}
